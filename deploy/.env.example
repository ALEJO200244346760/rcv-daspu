# Copiar a .env y completar. NUNCA subir .env a GitHub.

# Dominio del backend. Sin dominio propio podés usar la IP de la VM con sslip.io,
# ej. si la IP es 129.151.10.20 → 129-151-10-20.sslip.io
API_DOMAIN=129-151-10-20.sslip.io

# URL del frontend en Cloudflare Pages (separar varias con coma)
CORS_ALLOWED_ORIGINS=https://rcv-daspu.pages.dev

DB_NAME=rcv
DB_USER=rcv
DB_PASSWORD=cambiar-por-una-clave-larga
DB_ROOT_PASSWORD=cambiar-por-otra-clave-larga

# Generar con:  openssl rand -base64 48
JWT_SECRET=
